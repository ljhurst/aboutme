{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true,
        "declaration": false,
        "outDir": "./dist",
        "rootDir": "./",
        "resolveJsonModule": true
    },
    "exclude": ["node_modules", "dist"]
}
