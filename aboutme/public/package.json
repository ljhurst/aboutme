{
    "name": "aboutme",
    "version": "1.4.0",
    "description": "A repository for my personal website",
    "type": "module",
    "main": "index.js",
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "npm run lint -- --fix",
        "preflight": "npm run format && npm run lint:fix",
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "rm -rf dist && mkdir -p dist && cp -r images js index.html dist/ && npm run build:vendor && npm run build:css && npm run build:templates",
        "build:vendor": "mkdir -p dist/js/vendor && cp node_modules/handlebars/dist/handlebars.runtime.min.js dist/js/vendor/",
        "build:css": "tailwindcss -i src/tailwind.css -o dist/css/tailwind.css --minify",
        "build:templates": "handlebars templates -e hbs -f dist/js/templates.js --min"
    },
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "eslint": "^9.24.0",
        "globals": "^16.5.0",
        "handlebars": "^4.7.10",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.3"
    }
}
