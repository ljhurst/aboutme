<li class='mb-4 list-none col-span-2 md:col-span-3 lg:col-span-5'>
    <div class='bg-white rounded-lg shadow-sm border border-gray-200 p-4'>
        <div class='flex flex-col items-center justify-center py-8 text-center'>
            <div class='text-red-500 text-4xl mb-4'>⚠️</div>
            <h3 class='text-lg font-semibold text-gray-900 mb-2'>Oh no!</h3>
            <p class='text-gray-600 mb-6'>{{message}}</p>
            {{#if canRetry}}
                <button
                    data-section='{{sectionName}}'
                    class='retry-button px-6 py-2 bg-[#006400] hover:bg-[#008000] text-white font-semibold rounded-full transition-colors duration-200'
                >
                    <span class='retry-spinner hidden'></span>
                    Retry
                </button>
            {{/if}}
        </div>
    </div>
</li>
